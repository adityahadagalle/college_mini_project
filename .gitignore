# ---------------------------------------------------------------------------
# Redundant Nested Zip Extraction
# ---------------------------------------------------------------------------
sentiment-intelligence-platform-main/

# ---------------------------------------------------------------------------
# Python & Virtual Environments
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
backend/.venv/
.conda/

# ---------------------------------------------------------------------------
# Machine Learning Model Weights & Large Checkpoints (MUST EXCLUDE FROM GIT)
# ---------------------------------------------------------------------------
*.safetensors
*.bin
*.pt
*.pth
*.h5
*.hdf5
*.msgpack
*.keras
*.onnx
*.pkl
*.tflite
models/**/*.safetensors
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/*.h5
models/**/*.keras
models/**/*.msgpack
models/**/*.onnx
models/**/*.pkl
models/tf_sentiment_model.keras

# Whitelist JSON metadata, configs, and documentation for model architectures
!*_metadata.json
!*metadata.json
!model_metadata.json
!config.json
!tokenizer.json
!tokenizer_config.json
!special_tokens_map.json
!vocab.txt
!merges.txt

# ---------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx

# ---------------------------------------------------------------------------
# Databases, Checkpoints & Local Storage
# ---------------------------------------------------------------------------
*.sqlite3
*.db
*.db-journal
sentiment.db
batch_uploads/*
!batch_uploads/.gitkeep
uploads/*
!uploads/.gitkeep
batch_results/*
!batch_results/.gitkeep
results/*
!results/.gitkeep

# ---------------------------------------------------------------------------
# Testing & Coverage
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# Node.js, Frontend & Build Artifacts
# ---------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# IDEs & System Files
# ---------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
