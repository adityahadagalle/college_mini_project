# Application Settings
PROJECT_NAME="AI Sentiment Analysis Platform"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & Secrets (Override SECRET_KEY in production with a 32+ byte key)
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_ENV_FILE_32_BYTES_MINIMUM"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./sentiment.db"
REDIS_URL="redis://localhost:6379/0"

# Model Paths & Config
TF_MODEL_PATH="models/tf_sentiment_model.keras"
MODEL_METADATA_PATH="models/model_metadata.json"
MAX_SINGLE_PREDICT_LEN=5000
BATCH_PROCESSING_SIZE=64
DEFAULT_CONFIDENCE_THRESHOLD=0.50
